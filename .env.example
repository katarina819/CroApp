# Kopiraj u .env i upiši svoj ključ. .env se NE commita.
#
# Ključ je ograničen u Google Cloud Consoleu na paket aplikacije i SHA-1
# otisak potpisa, pa preuzet iz bundlea nikom ne koristi.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Ključ za Google Maps SDK na Androidu (karta). Odvojen od gornjeg —
# to su dva različita ključa. Umeće ga app.config.js.
EXPO_PUBLIC_ANDROID_MAPS_API_KEY=

# Sentry DSN. Kad nije postavljen, prijavljivanje padova je isključeno.
EXPO_PUBLIC_SENTRY_DSN=
